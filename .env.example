# Firebase Configuration
# Copy this file to .env and fill in your values from the Firebase Console.
# See FIREBASE_SETUP.md for step-by-step instructions.

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789000
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789000:web:abcdef123456

# Google OAuth Client IDs (from Firebase Console → Authentication → Google → Web client ID)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=123456789000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
