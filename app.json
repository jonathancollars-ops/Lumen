{
  "expo": {
    "name": "Lumen",
    "slug": "lumen",
    "version": "3.7.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": [
      "lumen",
      "com.jothacsf.organiza",
      "com.jothacsf.Organiza",
      "com.googleusercontent.apps.505145390874-dsluagocjfj15rjso9nsbgc282d4nvv8"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jothacsf.Organiza",
      "permissions": [
        "USE_EXACT_ALARM",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "lumen"
            },
            {
              "scheme": "com.jothacsf.organiza"
            },
            {
              "scheme": "com.jothacsf.Organiza"
            },
            {
              "scheme": "com.googleusercontent.apps.505145390874-dsluagocjfj15rjso9nsbgc282d4nvv8"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0ebf6043-6c5c-4335-a4a5-753770de3865"
      }
    },
    "plugins": [
      "./plugins/withAppActions.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00FFAA"
        }
      ]
    ]
  }
}
